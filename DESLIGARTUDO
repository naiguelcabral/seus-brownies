#!/usr/bin/env bash

# Salva o estado atual do projeto no GitHub antes de encerrar o trabalho.
# Uso manual: pede confirmação S/N antes de qualquer alteração no Git.
# Uso não interativo (ex.: Codex): permitido somente em branch de trabalho;
# prossegue automaticamente e usa a mensagem padrão.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Este arquivo deve ficar dentro de um repositório Git."
  exit 1
fi

BRANCH="$(git branch --show-current)"
if [[ -z "$BRANCH" ]]; then
  echo "Não foi possível identificar a branch atual."
  exit 1
fi

DEFAULT_MESSAGE="checkpoint: salvar trabalho antes de desligar"

# Em execução não interativa, nunca publicar automaticamente a main.
if [[ ! -t 0 && "$BRANCH" == "main" ]]; then
  echo "ERRO: DESLIGARTUDO não pode executar commit/push automático na branch main."
  echo "Crie ou use uma branch de trabalho antes do checkpoint automático."
  exit 1
fi

# Confirmação real para uso manual. Antes, um 'S' digitado no primeiro prompt
# era interpretado como mensagem de commit, gerando commits chamados apenas 'S'.
if [[ -t 0 ]]; then
  read -r -p "Salvar e sincronizar o trabalho antes de desligar? [S/n]: " CONFIRM
  CONFIRM="${CONFIRM:-S}"
  case "${CONFIRM,,}" in
    s|sim|y|yes)
      ;;
    *)
      echo "Operação cancelada. Nenhum commit/pull/push foi executado."
      exit 0
      ;;
  esac
fi

# Fecha a memória local antes do checkpoint Git. A pasta .codex-local é
# ignorada pelo Git para impedir que conversas brutas sejam publicadas.
if [[ -f "$ROOT_DIR/scripts/codex/conversation_memory.py" ]]; then
  if ! python3 "$ROOT_DIR/scripts/codex/conversation_memory.py" finalize; then
    echo "⚠ A memória local do Codex não pôde ser finalizada."
    echo "O salvamento do código continuará; nenhuma conversa será adicionada ao Git."
  fi
fi

# Defesa adicional: arquivos de ambiente/segredo conhecidos não podem ser
# adicionados por este fluxo, mesmo se a configuração local do Git mudar.
SENSITIVE_PATHS=(
  ".env"
  ".env.local"
  ".env.development"
  ".env.production"
  ".env.test"
)
for sensitive in "${SENSITIVE_PATHS[@]}"; do
  if git ls-files --error-unmatch "$sensitive" >/dev/null 2>&1; then
    echo "ERRO: arquivo sensível versionado detectado: $sensitive"
    echo "Remova-o do índice Git antes de usar DESLIGARTUDO."
    exit 1
  fi
done

if [[ -n "$(git status --porcelain)" ]]; then
  if [[ -t 0 ]]; then
    read -r -p "Mensagem do salvamento [${DEFAULT_MESSAGE}]: " COMMIT_MESSAGE
    COMMIT_MESSAGE="${COMMIT_MESSAGE:-$DEFAULT_MESSAGE}"
  else
    COMMIT_MESSAGE="$DEFAULT_MESSAGE"
  fi

  git add --all
  git commit -m "$COMMIT_MESSAGE"
else
  echo "Não há alterações novas para criar um commit."
fi

REMOTE_BRANCH_STATUS=0
git ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1 || REMOTE_BRANCH_STATUS=$?

if [[ "$REMOTE_BRANCH_STATUS" -eq 0 ]]; then
  if ! git pull --rebase origin "$BRANCH"; then
    echo
    echo "Não foi possível atualizar antes do envio. Resolva o rebase e execute './DESLIGARTUDO' novamente."
    exit 1
  fi

  if ! git push origin "$BRANCH"; then
    echo
    echo "O commit foi salvo localmente, mas não pôde ser enviado ao GitHub. Execute './DESLIGARTUDO' novamente quando a conexão voltar."
    exit 1
  fi
elif [[ "$REMOTE_BRANCH_STATUS" -eq 2 ]]; then
  echo "A branch remota origin/$BRANCH ainda não existe; publicando-a pela primeira vez."
  if ! git push -u origin "$BRANCH"; then
    echo
    echo "O commit foi salvo localmente, mas a primeira publicação não pôde ser enviada ao GitHub. Execute './DESLIGARTUDO' novamente quando a conexão voltar."
    exit 1
  fi
else
  echo
  echo "Não foi possível verificar se origin/$BRANCH existe (git ls-remote retornou $REMOTE_BRANCH_STATUS)."
  echo "Nenhum pull ou push foi executado. Verifique a conexão/autorização e execute './DESLIGARTUDO' novamente."
  exit 1
fi

echo
echo "Pronto: o trabalho foi salvo no GitHub. Agora você pode desligar o computador."
