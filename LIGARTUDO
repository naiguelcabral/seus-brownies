#!/usr/bin/env bash

# Atualiza o projeto quando for seguro, verifica os MCPs e inicia o painel local dos Seus Brownies.

set -euo pipefail

PREPARE_ONLY=false
CODEX_MODE=false

if [[ "${1:-}" == "--prepare-only" ]]; then
  PREPARE_ONLY=true
elif [[ "${1:-}" == "--codex" ]]; then
  CODEX_MODE=true
elif [[ $# -gt 0 ]]; then
  echo "Uso: $0 [--prepare-only|--codex]"
  exit 2
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

echo
echo "========================================"
echo " Seus Brownies - Inicialização local"
echo "========================================"
echo

# 1. Verifica Node.js e npm
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "Node.js e npm não estão disponíveis neste terminal."
  echo "Feche e abra um novo terminal do VS Code e tente novamente."
  exit 1
fi

echo "✓ Node.js e npm disponíveis"

# 2. Instala dependências se necessário
if [[ ! -d node_modules ]]; then
  echo
  echo "Instalando as dependências do projeto..."
  npm ci
fi

# 3. Atualiza Git somente quando for seguro. O controlador autônomo usa
# --prepare-only para não tocar em remoto durante o preflight.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  BRANCH="$(git branch --show-current)"

  echo
  echo "Verificando repositório Git..."

  if [[ -z "$BRANCH" ]]; then
    echo "⚠ Não foi possível identificar a branch atual."
    echo "O painel será iniciado com o estado local."

  elif [[ "$PREPARE_ONLY" == true || "$CODEX_MODE" == true ]]; then
    echo "✓ Preflight Git concluído; atualização remota foi ignorada"
  elif ! git remote get-url origin >/dev/null 2>&1; then
    echo "⚠ O remoto origin não está configurado."
    echo "O painel será iniciado com o estado local."

  elif [[ -n "$(git status --porcelain)" ]]; then
    echo "⚠ Há alterações locais."
    echo "A atualização do GitHub foi adiada para não sobrescrever seu trabalho."

  else
    REMOTE_BRANCH_STATUS=0

    git ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1 \
      || REMOTE_BRANCH_STATUS=$?

    if [[ "$REMOTE_BRANCH_STATUS" -eq 0 ]]; then
      echo "Buscando atualizações do GitHub..."

      if git pull --ff-only origin "$BRANCH"; then
        echo "✓ Repositório atualizado"
      else
        echo "⚠ Não foi possível atualizar agora."
        echo "O painel será iniciado com a versão local."
      fi

    elif [[ "$REMOTE_BRANCH_STATUS" -eq 2 ]]; then
      echo "⚠ A branch $BRANCH ainda não foi publicada em origin."
      echo "O painel será iniciado com o estado local."

    else
      echo "⚠ Não foi possível verificar origin/$BRANCH."
      echo "git ls-remote retornou: $REMOTE_BRANCH_STATUS"
      echo "A atualização foi adiada."
    fi
  fi
fi

# 4. Prepara a infraestrutura e a memória operacional local do Codex.
echo
echo "Preparando memória local do Codex..."

if [[ -f "$ROOT_DIR/scripts/codex/conversation_memory.py" ]]; then
  if python3 "$ROOT_DIR/scripts/codex/conversation_memory.py" prepare; then
    echo "✓ Infraestrutura local do Codex validada pelas primitivas endurecidas"
    echo "✓ Contexto local pronto para a próxima sessão do Codex"
    echo "ℹ Captura automática exige configuração local do usuário; veja docs/governance/LOCAL-CONVERSATION-MEMORY.md"
  else
    echo "⚠ Não foi possível preparar a memória local; a inicialização continuará."
  fi
else
  echo "⚠ Registrador de conversas do Codex não encontrado"
fi

# 5. Verifica configuração MCP do VS Code sem abrir arquivos
echo
echo "Verificando MCPs do VS Code..."

MCP_CONFIG="$ROOT_DIR/.vscode/mcp.json"

if [[ -f "$MCP_CONFIG" ]]; then
  echo "✓ .vscode/mcp.json encontrado"

  for MCP in \
    "cloudflare-docs" \
    "cloudflare-observability" \
    "cloudflare-builds"
  do
    if grep -q "\"$MCP\"" "$MCP_CONFIG"; then
      echo "✓ $MCP configurado"
    else
      echo "⚠ $MCP não encontrado no mcp.json"
    fi
  done
else
  echo "⚠ .vscode/mcp.json não encontrado"
fi

# 6. Verifica MCPs disponíveis no Codex CLI
echo
echo "Verificando MCPs do Codex..."

MCP_PREFLIGHT_OK=true
if command -v codex >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  if MCP_REPORT="$(codex mcp list --json 2>/dev/null | python3 -c '
import json
import sys

required = (
    "github", "neon", "cloudflare-api", "cloudflare-docs",
    "cloudflare-observability", "cloudflare-builds", "openaiDeveloperDocs",
)
try:
    servers = {item["name"]: item for item in json.load(sys.stdin)}
except (ValueError, KeyError, TypeError):
    sys.exit(1)
missing = False
for name in required:
    if servers.get(name, {}).get("enabled") is True:
        print(f"✓ {name} disponível no Codex")
    else:
        print(f"⚠ {name} não encontrado no Codex")
        missing = True
print("ℹ cloudflare-bindings OPTIONAL / NON_BLOCKING")
sys.exit(1 if missing else 0)
')"; then
    echo "$MCP_REPORT"
  else
    echo "$MCP_REPORT"
    echo "⚠ Não foi possível validar todos os MCPs do Codex"
    MCP_PREFLIGHT_OK=false
  fi
else
  echo "⚠ Codex CLI ou Python 3 não encontrado neste terminal"
  MCP_PREFLIGHT_OK=false
fi

if "$ROOT_DIR/scripts/codex/setup-github-mcp-credential.sh" --check >/dev/null 2>&1; then
  echo "✓ GitHub PAT disponível no keyring"
else
  echo "⚠ GitHub PAT não disponível no keyring"
  MCP_PREFLIGHT_OK=false
fi

# 7. O modo de preparação termina aqui; ele nunca inicia o servidor.
if [[ "$PREPARE_ONLY" == true ]]; then
  echo
  echo "✓ Preparação local concluída; servidor não iniciado (--prepare-only)."
  exit 0
fi

if [[ "$CODEX_MODE" == true ]]; then
  if [[ "$MCP_PREFLIGHT_OK" != true ]]; then
    echo "Preflight MCP incompleto; Codex não iniciado." >&2
    exit 1
  fi
  exec "$ROOT_DIR/scripts/codex/start-codex.sh"
fi

echo "ℹ Para registrar comandos e saídas desta sessão, execute separadamente:"
echo "  scripts/codex/record_terminal_session.sh"

# 8. Inicia o ambiente HML local
echo
echo "========================================"
echo "Iniciando o projeto HML local"
echo "========================================"
echo
echo "Abra no navegador:"
echo "http://localhost:3000"
echo

exec npm run dev:hml
