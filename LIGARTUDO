#!/usr/bin/env bash

# Atualiza o projeto quando for seguro e inicia o painel local dos Seus Brownies.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "Node.js e npm não estão disponíveis neste terminal."
  echo "Feche e abra um novo terminal do VS Code e tente novamente."
  exit 1
fi

if [[ ! -d node_modules ]]; then
  echo "Instalando as dependências do projeto..."
  npm ci
fi

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  BRANCH="$(git branch --show-current)"

  if [[ -z "$BRANCH" ]]; then
    echo "Não foi possível identificar a branch atual. O painel será iniciado com o estado local."
  elif ! git remote get-url origin >/dev/null 2>&1; then
    echo "O remoto origin não está configurado. O painel será iniciado com o estado local."
  elif [[ -n "$(git status --porcelain)" ]]; then
    echo "Há alterações locais. A atualização do GitHub foi adiada para não sobrescrever seu trabalho."
  else
    REMOTE_BRANCH_STATUS=0
    git ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1 || REMOTE_BRANCH_STATUS=$?

    if [[ "$REMOTE_BRANCH_STATUS" -eq 0 ]]; then
      echo "Buscando atualizações do GitHub..."
      if ! git pull --ff-only origin "$BRANCH"; then
        echo "Não foi possível atualizar agora. O painel será iniciado com a versão local."
      fi
    elif [[ "$REMOTE_BRANCH_STATUS" -eq 2 ]]; then
      echo "A branch $BRANCH ainda não foi publicada em origin. O painel será iniciado com o estado local."
    else
      echo "Não foi possível verificar se origin/$BRANCH existe (git ls-remote retornou $REMOTE_BRANCH_STATUS)."
      echo "A atualização foi adiada. O painel será iniciado com a versão local."
    fi
  fi
fi

echo
echo "Abrindo configuração dos MCPs da Cloudflare..."
code "$ROOT_DIR/.vscode/mcp.json" --reuse-window >/dev/null 2>&1 &

echo
echo "Iniciando o projeto. Abra http://localhost:3000 no navegador."
exec npm run dev