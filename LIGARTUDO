#!/usr/bin/env bash

# Prepara o projeto e inicia o painel local dos Seus Brownies.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "Node.js e npm não estão disponíveis neste terminal."
  echo "Feche e abra um novo terminal do VS Code e tente novamente."
  exit 1
fi

if [[ ! -d node_modules ]]; then
  echo "Instalando as dependências do projeto..."
  npm ci
fi

BRANCH="$(git branch --show-current)"
echo "Buscando atualizações do GitHub..."
git pull --ff-only origin "$BRANCH"

echo
echo "Iniciando o projeto. Abra http://localhost:3000 no navegador."
npm run dev
