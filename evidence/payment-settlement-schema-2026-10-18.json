    "DO $$ DECLARE t record; different boolean; BEGIN FOR t IN SELECT DISTINCT table_name FROM pg_temp.settlement_before LOOP EXECUTE format('SELECT EXISTS(SELECT row_data FROM pg_temp.settlement_before WHERE table_name=%L EXCEPT SELECT to_jsonb(r)-%L FROM public.%I r)',t.table_name,CASE t.table_name WHEN 'sales' THEN 'payment_details' WHEN 'financial_events' THEN 'payment_fee' WHEN 'expenses' THEN 'classification' ELSE '__new_nonexistent_field__' END,t.table_name) INTO different; IF different THEN RAISE EXCEPTION 'EXISTING_ROW_CHANGED_%',t.table_name; END IF; END LOOP; END $$",
