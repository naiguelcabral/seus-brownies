    "CREATE TEMP TABLE settlement_before(table_name text,row_data jsonb) ON COMMIT DROP",
    "DO $$ DECLARE t record; BEGIN FOR t IN SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename LOOP EXECUTE format('LOCK TABLE public.%I IN SHARE ROW EXCLUSIVE MODE',t.tablename); EXECUTE format('INSERT INTO pg_temp.settlement_before SELECT %L,to_jsonb(r) FROM public.%I r',t.tablename,t.tablename); END LOOP; END $$",
