{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/router.tsx",
    "src/start.ts",
    "src/routes/**/*.{ts,tsx}",
    "test/**/*.test.ts",
    "e2e/**/*.spec.ts",
    "e2e/fixtures/product-editor/main.tsx",
    "e2e/fixtures/dashboard/main.tsx",
    "e2e/fixtures/catalog-editors/main.tsx",
    "e2e/fixtures/payment-fees/main.tsx",
    "e2e/fixtures/operation-finance/main.tsx",
    "scripts/**/*.{ts,js,mjs}",
    "*.config.{ts,js,mjs}",
    "playwright.*.config.ts",
    "e2e/fixtures/scenario-ux/main.tsx",
    "e2e/fixtures/operations-ux/main.tsx",
    "e2e/fixtures/operations-ux/router.ts",
    "e2e/fixtures/operations-ux/start.ts",
    "e2e/fixtures/operations-ux/Layout.tsx",
    "e2e/fixtures/operations-ux/state.ts",
    "e2e/fixtures/integrity-report/main.tsx",
    "e2e/fixtures/integrity-report/router.ts",
    "e2e/fixtures/integrity-report/components.tsx",
    "e2e/fixtures/integrity-report/reports.ts",
    "e2e/fixtures/integrity-report/csv.ts",
    "e2e/fixtures/integrity-report/money.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,mjs}",
    "test/**/*.{ts,tsx,js,mjs}",
    "e2e/**/*.{ts,tsx,js,mjs}",
    "scripts/**/*.{ts,js,mjs}",
    "*.{ts,js,mjs}"
  ],
  "ignore": ["src/routeTree.gen.ts", "**/*.d.ts"],
  "drizzle": {
    "config": []
  },
  "vite": {
    "config": []
  },
  "playwright": {
    "config": []
  }
}
