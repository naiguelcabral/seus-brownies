{
  "name": "seus-brownies",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "sync:project": "node scripts/project-sync/cli.mjs",
    "test:project-sync": "node scripts/project-sync/sync.spec.mjs",
    "dev": "vite dev --port 3000",
    "dev:hml": "CLOUDFLARE_ENV=hml vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:hml": "bash scripts/build-hml-isolated.sh",
    "build:ci-isolated": "bash scripts/build-ci-isolated.sh",
    "preview": "vite preview",
    "ligar": "bash ./LIGARTUDO",
    "desligar": "bash ./DESLIGARTUDO",
    "ligartudo": "bash ./LIGARTUDO",
    "desligartudo": "bash ./DESLIGARTUDO",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "bash scripts/test-fixtures-isolated.sh",
    "test:e2e:connected": "bash scripts/test-connected-isolated.sh",
    "format": "oxfmt src test e2e scripts .github package.json knip.json knip-baseline.json tsconfig.json vite.config.ts playwright.config.ts playwright.auth-hml.config.ts playwright.public-local.config.ts playwright.integrity-report.config.ts drizzle.config.ts tsr.config.json .oxlintrc.json .oxfmtrc.json .vscode/settings.json playwright.isolated-fixtures.config.ts .vscode/extensions.json",
    "check": "oxfmt --check src test e2e scripts .github package.json knip.json knip-baseline.json tsconfig.json vite.config.ts playwright.config.ts playwright.auth-hml.config.ts playwright.public-local.config.ts playwright.integrity-report.config.ts drizzle.config.ts tsr.config.json .oxlintrc.json .oxfmtrc.json .vscode/settings.json playwright.isolated-fixtures.config.ts .vscode/extensions.json",
    "deploy": "npm run build && wrangler deploy",
    "deploy:hml": "HML_DEPLOY=1 bash scripts/build-hml-isolated.sh",
    "secret:hml": "wrangler secret put --env hml",
    "db:generate": "node scripts/drizzle-kit-guard.mjs generate",
    "db:prepare": "node scripts/migration-chain-prepare.mjs",
    "db:review": "node scripts/migration-chain-prepare.mjs --review",
    "db:migrate": "node scripts/migration-chain-preflight.mjs",
    "db:migrate:preflight": "node scripts/migration-chain-preflight.mjs",
    "db:push": "node scripts/drizzle-kit-guard.mjs push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "import:preview": "python3 scripts/preview_workbook.py",
    "import:catalog": "tsx scripts/import_catalog.ts",
    "import:history:preview": "python3 scripts/preview_history_workbook.py",
    "import:history": "tsx scripts/import_history.ts",
    "production:preview": "python3 scripts/preview_production_workbook.py",
    "production:import": "tsx scripts/import_production.ts",
    "production:profiles:sync": "tsx scripts/sync_production_profile_components.ts",
    "fifo:backfill:hml": "tsx scripts/backfill-hml-fifo.ts",
    "lint:fix": "npm run lint -- --fix",
    "knip:audit": "knip --config knip.json --no-progress",
    "knip:report": "knip --config knip.json --no-progress --reporter json",
    "knip:check": "node scripts/check-knip.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@neondatabase/neon-js": "0.8.0-beta",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.577.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "0.31.11",
    "knip": "6.41.0",
    "oxc-parser": "0.154.0",
    "oxc-transform": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "typescript": "7.0.2",
    "launch-editor": "2.14.2",
    "shell-quote": "1.12.0",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "miniflare": {
      "undici": "^7.30.1"
    },
    "zod": "$zod"
  }
}
