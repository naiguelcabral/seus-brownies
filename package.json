{
  "name": "seus-brownies",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:hml": "CLOUDFLARE_ENV=hml vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:hml": "bash scripts/build-hml-isolated.sh",
    "preview": "vite preview",
    "ligar": "bash ./LIGARTUDO",
    "desligar": "bash ./DESLIGARTUDO",
    "ligartudo": "bash ./LIGARTUDO",
    "desligartudo": "bash ./DESLIGARTUDO",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "deploy:hml": "HML_DEPLOY=1 bash scripts/build-hml-isolated.sh",
    "secret:hml": "wrangler secret put --env hml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "import:preview": "python3 scripts/preview_workbook.py",
    "import:catalog": "tsx scripts/import_catalog.ts",
    "import:history:preview": "python3 scripts/preview_history_workbook.py",
    "import:history": "tsx scripts/import_history.ts",
    "production:preview": "python3 scripts/preview_production_workbook.py",
    "production:import": "tsx scripts/import_production.ts",
    "production:profiles:sync": "tsx scripts/sync_production_profile_components.ts",
    "fifo:backfill:hml": "tsx scripts/backfill-hml-fifo.ts"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
