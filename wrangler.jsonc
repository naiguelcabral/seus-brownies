{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cacau-v1",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "env": {
    "hml": {
      "name": "cacau-v1-hml",
      "workers_dev": true,
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "persist": true,
          "head_sampling_rate": 1
        },
        "issues": {
          "enabled": false
        }
      },
      "vars": {
        "AUTH_RATE_LIMITER_REQUIRED": "true",
        "PASSWORD_RESET_REDIRECT_ORIGIN": "https://cacau-v1-hml.naiguelcabral.workers.dev"
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2026091001",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "AUTH_ORIGIN_RATE_LIMITER",
          "namespace_id": "2026102504",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "AUTH_AGGREGATE_RATE_LIMITER",
          "namespace_id": "2026102505",
          "simple": {
            "limit": 600,
            "period": 60
          }
        }
      ],
      "secrets": {
        "required": [
          "DATABASE_URL",
          "NEON_AUTH_BASE_URL",
          "NEON_AUTH_COOKIE_SECRET",
          "TURNSTILE_SECRET_KEY",
          "AUTH_LOGIN_HASH_PEPPER",
          "AUTH_DIRECTORY_DATABASE_URL"
        ]
      }
    },
    "pilot": {
      "name": "cacau-v1-piloto",
      "workers_dev": true,
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "persist": true,
          "head_sampling_rate": 1
        },
        "issues": {
          "enabled": false
        }
      },
      "vars": {
        "AUTH_RATE_LIMITER_REQUIRED": "true",
        "PASSWORD_RESET_REDIRECT_ORIGIN": "https://cacau-v1-piloto.naiguelcabral.workers.dev"
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2026102601",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "AUTH_ORIGIN_RATE_LIMITER",
          "namespace_id": "2026102602",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "AUTH_AGGREGATE_RATE_LIMITER",
          "namespace_id": "2026102603",
          "simple": {
            "limit": 600,
            "period": 60
          }
        }
      ],
      "secrets": {
        "required": [
          "DATABASE_URL",
          "NEON_AUTH_BASE_URL",
          "NEON_AUTH_COOKIE_SECRET",
          "TURNSTILE_SECRET_KEY",
          "AUTH_LOGIN_HASH_PEPPER",
          "AUTH_DIRECTORY_DATABASE_URL"
        ]
      }
    }
  },
  "vars": {
    "AUTH_RATE_LIMITER_REQUIRED": "true"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026102501",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AUTH_ORIGIN_RATE_LIMITER",
      "namespace_id": "2026102502",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AUTH_AGGREGATE_RATE_LIMITER",
      "namespace_id": "2026102503",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "DATABASE_URL",
      "NEON_AUTH_BASE_URL",
      "NEON_AUTH_COOKIE_SECRET",
      "TURNSTILE_SECRET_KEY",
      "AUTH_LOGIN_HASH_PEPPER",
      "AUTH_DIRECTORY_DATABASE_URL"
    ]
  },
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
